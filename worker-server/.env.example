# Use long random values (32+ bytes). Never commit real secrets.
PORT=8787
HOST=0.0.0.0
POCKETMIND_API_TOKEN=replace-with-a-random-32-byte-api-token
POCKETMIND_ENROLLMENT_TOKEN=replace-with-a-different-random-32-byte-enrollment-token
POCKETMIND_DATA_FILE=./data/pocketmind-state.json
POCKETMIND_LEASE_MS=90000
POCKETMIND_HEARTBEAT_TIMEOUT_MS=60000
# Optional comma-separated browser origins. Native apps do not send Origin.
POCKETMIND_ALLOWED_ORIGINS=
